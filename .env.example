HTTP_PORT=8080

# Banco local (SQLite) onde o aplicativo guarda sua propria configuracao
# (servidores salvos e grupos) - nao precisa de PostgreSQL instalado.
# Se nao informado, o padrao e %APPDATA%\PostgresManagementStudio\postgres-management-studio.db
# (EN) Local SQLite database where the app stores its own configuration
# (saved servers and groups) - no PostgreSQL needed.
# If not set, the default is %APPDATA%\PostgresManagementStudio\postgres-management-studio.db
STUDIO_DB=./postgres-management-studio.db

FRONTEND_DIR=./web/dist

# Idioma da interface (default: en)
# (EN) UI language (default: en)
LANGUAGE=en
